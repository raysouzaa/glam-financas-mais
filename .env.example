APP_NAME="GlamFinanças"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=financaplus
DB_USERNAME=financaplus
DB_PASSWORD=troque_esta_senha
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=FinancaPlus_Lancamentos
# Conta (e-mail) cujos lançamentos são sincronizados com a planilha. Vazio = administrador mais antigo.
GOOGLE_SHEETS_OWNER_EMAIL=
# Sincronização automática (scheduler, a cada minuto). false = desligada; `php artisan finance:sync-sheets` ainda roda manualmente.
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/var/www/html/storage/app/google-service-account.json

# E-mail. Padrão: Mailpit (só desenvolvimento; nada chega de verdade, veja em http://localhost:8025).
# Para entregar de verdade, troque o bloco abaixo por um destes e recrie app e worker:
#
# Mais fácil: rode scripts/configurar-email.sh (resend, gmail ou outro).
#
# Resend (grátis ~3.000/mês; domínio verificado no Resend, DNS no Cloudflare):
#   MAIL_HOST=smtp.resend.com  MAIL_PORT=587  MAIL_SCHEME=null
#   MAIL_USERNAME=resend  MAIL_PASSWORD='<API key re_...>'
#   MAIL_FROM_ADDRESS=nao-responda@vyrasolutions.com.br
#
# Gmail (grátis, ~500/dia; exige verificação em 2 etapas e uma "senha de app"):
#   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null
#   MAIL_USERNAME=seu@gmail.com  MAIL_PASSWORD=<senha de app de 16 letras>
#   MAIL_FROM_ADDRESS=seu@gmail.com
#
# Brevo (grátis, ~300/dia; remetente verificado no painel):
#   MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587  MAIL_SCHEME=null
#   MAIL_USERNAME=<login SMTP do Brevo>  MAIL_PASSWORD=<chave SMTP do Brevo>
#   MAIL_FROM_ADDRESS=<e-mail verificado no Brevo>
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=nao-responda@financaplus.local
MAIL_FROM_NAME="${APP_NAME}"

# Conta administradora criada por `php artisan db:seed` (AdminSeeder). Senha vazia = gera uma forte e mostra no terminal.
ADMIN_EMAIL=
ADMIN_NAME="Administrador"
ADMIN_PASSWORD=
REGISTRATION_ENABLED=true
REGISTRATION_ALLOWED_EMAILS=
EMAIL_VERIFICATION_EXPIRE=60
