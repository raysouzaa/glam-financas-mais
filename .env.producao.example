# Modelo do .env de PRODUÇÃO. No servidor: cp .env.producao.example .env e preencha os campos marcados com <...>.
# Passo a passo completo em DEPLOY.md.

# Faz o `docker compose` aplicar os ajustes de produção (porta só em 127.0.0.1, limites de memória, sem Mailpit).
COMPOSE_FILE=compose.yaml:compose.prod.yaml

APP_NAME="GlamFinanças"
APP_ENV=production
APP_DEBUG=false
# Gerada no servidor com `php artisan key:generate` (não reutilize a chave do ambiente local).
APP_KEY=
# Endereço público, com https. É usado nos links dos e-mails (confirmação de conta e redefinição de senha).
APP_URL=https://<seu-dominio>

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=financaplus
DB_USERNAME=financaplus
# Senha nova e forte, só letras e números (ex.: `openssl rand -hex 24`). Vale a partir da primeira subida do banco.
DB_PASSWORD=<senha-forte>

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
# O cookie de sessão só trafega por HTTPS.
SESSION_SECURE_COOKIE=true

# Google Sheets: sincronização automática desligada. Para ligar, envie também storage/app/google-service-account.json.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=FinancaPlus_Lancamentos
# Conta (e-mail) cujos lançamentos são sincronizados com a planilha. Vazio = administrador mais antigo.
GOOGLE_SHEETS_OWNER_EMAIL=
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/var/www/html/storage/app/google-service-account.json

# E-mail real (Resend). Use os mesmos valores do .env local, que já entrega de verdade.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=<api-key-do-resend>
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=nao-responda@vyrasolutions.com.br
MAIL_FROM_NAME="${APP_NAME}"

# As contas vêm no dump do banco, então o AdminSeeder não é necessário.
ADMIN_EMAIL=
ADMIN_NAME="Administrador"
ADMIN_PASSWORD=

# Quem pode criar conta pela tela. Para restringir: REGISTRATION_ALLOWED_EMAILS=a@exemplo.com,b@exemplo.com
REGISTRATION_ENABLED=true
REGISTRATION_ALLOWED_EMAILS=
EMAIL_VERIFICATION_EXPIRE=60
